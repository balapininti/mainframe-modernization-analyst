//NITEBILL JOB (ACCT),'NIGHTLY BILL',CLASS=A
//* SORT ORDERS FIRST
//STEP010  EXEC PGM=SORT
//SORTIN   DD DSN=PROD.ORDERS.DAILY,DISP=SHR
//SORTOUT  DD DSN=PROD.ORDERS.SORTED(+1),
//            DISP=(NEW,CATLG,DELETE)
//SYSIN    DD *
  SORT FIELDS=(1,5,CH,A)
/*
//STEP020  EXEC PGM=BILLCALC,COND=(4,LT)
//CUSTMAST DD DSN=PROD.CUST.MASTER,DISP=SHR
//BILLOUT  DD DSN=PROD.BILL.OUT,DISP=(NEW,CATLG)
//SYSIN    DD DSN=PROD.CTL(BILLPARM),DISP=SHR
//STEP030  EXEC BILLPROC
//STEP040  EXEC PGM=IKJEFT01
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(ORPHANX) PLAN(P1)
/*
//STEP050  EXEC NOPROC
// IF (STEP020.RC > 4) THEN
//STEP060  EXEC PGM=IEFBR14
// ENDIF
